<%- include('../partials/header') %>
<div class="dashboard-wrap">
  <%- include('../partials/buyer-sidebar') %>
  <div class="dashboard-main">
    <div class="dashboard-header">
      <div class="dashboard-title">📋 Order History</div>
      <div class="dashboard-sub">All your completed and past orders</div>
    </div>
    <div class="card">
      <% if (orders.length > 0) { %>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Order ID</th><th>Item</th><th>Amount</th><th>Status</th><th>Escrow</th><th>Date</th><th>Action</th></tr></thead>
            <tbody>
              <% orders.forEach(o => { %>
                <tr>
                  <td class="font-mono text-sm text-green">#<%= o.id %></td>
                  <td><div style="font-weight:600"><%= o.title %></div></td>
                  <td class="text-gold font-bold"><%= o.amount.toLocaleString() %> EGP</td>
                  <td><span class="status status-<%= o.status %>"><%= o.status.replace('_',' ') %></span></td>
                  <td><span class="status status-<%= o.escrowStatus %>"><%= o.escrowStatus %></span></td>
                  <td class="text-muted text-sm"><%= o.createdAt %></td>
                  <td>
                    <% if (o.status === 'completed') { %>
                      <span class="btn btn-ghost btn-sm">⭐ Review</span>
                    <% } else if (o.dispute) { %>
                      <span class="btn btn-red btn-sm">⚖️ Dispute</span>
                    <% } else { %>
                      <span class="btn btn-ghost btn-sm">💬 Chat</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty-state">
          <div class="empty-state-icon">📋</div>
          <div class="empty-state-title">No orders yet</div>
          <a href="/marketplace" class="btn btn-green" style="margin-top:16px">Start Shopping</a>
        </div>
      <% } %>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
