<%- include('../partials/header') %>
<div class="dashboard-wrap">
  <%- include('../partials/buyer-sidebar') %>
  <div class="dashboard-main">
    <div class="dashboard-header">
      <div style="display:flex;align-items:center;justify-content:space-between">
        <div>
          <div class="dashboard-title">🔔 Notifications</div>
          <div class="dashboard-sub"><%= notifications.filter(n=>!n.read).length %> unread notifications</div>
        </div>
        <button class="btn btn-ghost btn-sm">Mark all as read</button>
      </div>
    </div>

    <div class="card">
      <% if (notifications.length > 0) { %>
        <% notifications.forEach(n => { %>
          <div style="display:flex;align-items:flex-start;gap:14px;padding:16px 20px;border-bottom:1px solid var(--border);transition:background 0.2s;<%= !n.read ? 'background:rgba(0,255,136,0.03)' : '' %>">
            <div style="width:40px;height:40px;border-radius:10px;background:<%= n.type === 'order' ? 'var(--green-glow)' : n.type === 'sale' ? 'var(--gold-glow)' : 'rgba(0,207,255,0.1)' %>;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0">
              <%= n.type === 'order' ? '📦' : n.type === 'sale' ? '💰' : '📢' %>
            </div>
            <div style="flex:1">
              <div style="font-size:14px;font-weight:<%= !n.read ? '600' : '400' %>;color:<%= !n.read ? 'var(--text)' : 'var(--text-dim)' %>"><%= n.message %></div>
              <div style="font-size:11px;color:var(--text-muted);margin-top:4px"><%= n.createdAt %></div>
            </div>
            <% if (!n.read) { %>
              <div style="width:8px;height:8px;background:var(--green);border-radius:50%;margin-top:6px;flex-shrink:0"></div>
            <% } %>
          </div>
        <% }) %>
      <% } else { %>
        <div class="empty-state">
          <div class="empty-state-icon">🔔</div>
          <div class="empty-state-title">No notifications</div>
          <p>You're all caught up!</p>
        </div>
      <% } %>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
