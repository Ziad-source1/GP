<%- include('../partials/header') %>
<div class="dashboard-wrap">
  <%- include('../partials/buyer-sidebar') %>
  <div class="dashboard-main">
    <div class="dashboard-header">
      <div class="dashboard-title">⏳ Active Orders</div>
      <div class="dashboard-sub">Orders currently in progress — confirm delivery to release escrow</div>
    </div>
    <% if (orders.length > 0) { %>
      <% orders.forEach(o => { %>
        <div class="card" style="margin-bottom:16px">
          <div class="card-body">
            <div style="display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:16px">
              <div>
                <div class="font-mono text-green text-sm" style="margin-bottom:4px">#<%= o.id %></div>
                <div style="font-size:18px;font-weight:700;margin-bottom:8px"><%= o.product_name %></div>
                <div style="display:flex;gap:10px;flex-wrap:wrap">
                  <% if (o.is_paid == 1) { %>
                    <span class="status status-completed">✅ Completed</span>
                  <% } else { %>
                    <span class="status status-in_progress">⏳ In Progress</span>
                  <% } %>
                  <% if (o.escrow_status) { %>
                    <span class="status status-<%= o.escrow_status %>">🔒 <%= o.escrow_status %></span>
                  <% } else { %>
                    <span class="status status-held">🔒 held</span>
                  <% } %>
                </div>
              </div>
              <div style="text-align:right">
                <div style="font-family:'Rajdhani',sans-serif;font-size:28px;font-weight:800;color:var(--gold)"><%= parseFloat(o.total_price).toLocaleString() %> EGP</div>
                <div style="font-size:12px;color:var(--text-muted)">Ordered: <%= o.created_at ? new Date(o.created_at).toISOString().split('T')[0] : '—' %></div>
              </div>
            </div>

            <!-- Escrow progress — real data -->
            <div style="margin-top:20px">
              <div class="escrow-steps">
                <div class="escrow-step active">
                  <div class="escrow-step-icon">💳</div>
                  <div class="escrow-step-line"></div>
                  <div class="escrow-step-label">Payment Locked</div>
                  <div class="escrow-step-sub">Funds in escrow</div>
                </div>
                <div class="escrow-step <%= o.is_paid == 1 ? 'active' : '' %>">
                  <div class="escrow-step-icon">📦</div>
                  <div class="escrow-step-line"></div>
                  <div class="escrow-step-label">Seller Delivered</div>
                  <div class="escrow-step-sub"><%= o.is_paid == 1 ? '✅ Done' : 'Waiting...' %></div>
                </div>
                <div class="escrow-step <%= o.escrow_status === 'released' ? 'active' : '' %>">
                  <div class="escrow-step-icon">💰</div>
                  <div class="escrow-step-label">Funds Released</div>
                  <div class="escrow-step-sub"><%= o.escrow_status === 'released' ? '✅ Completed' : '🔒 Locked' %></div>
                </div>
              </div>
            </div>

            <div style="display:flex;gap:10px;margin-top:16px;flex-wrap:wrap">
              <% if (o.escrow_status === 'released' || o.is_paid == 1) { %>
                <span class="btn btn-ghost btn-sm" style="cursor:default;color:var(--green)">✅ Order Complete</span>
              <% } else { %>
                <button class="btn btn-ghost btn-sm">💬 Chat with Seller</button>
                <a href="/buyer/disputes" class="sidebar-link <%= currentPath === '/buyer/disputes' ? 'active' : '' %>">
                <button class="btn btn-red btn-sm">⚖️ Open Dispute</button>
                <form action="/buyer/orders/<%= o.id %>/complete" method="POST" style="display:inline">
                  <button type="submit" class="btn btn-green btn-sm">📦 Mark as Complete</button>
                </form>
    </a>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="empty-state">
        <div class="empty-state-icon">⏳</div>
        <div class="empty-state-title">No active orders</div>
        <a href="/marketplace" class="btn btn-green" style="margin-top:16px">Browse Marketplace</a>
      </div>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>
