<%- include('../partials/header') %>
<div class="dashboard-wrap">
  <%- include('../partials/buyer-sidebar') %>
  <div class="dashboard-main">
    <div class="dashboard-header">
      <div class="dashboard-title">⏳ Active Orders</div>
      <div class="dashboard-sub">Orders currently in progress — confirm delivery to release escrow</div>
    </div>
    <% if (orders.length > 0) { %>
      <% orders.forEach(o => { %>
        <div class="card" style="margin-bottom:16px">
          <div class="card-body">
            <div style="display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:16px">
              <div>
                <div class="font-mono text-green text-sm" style="margin-bottom:4px">#<%= o.id %></div>
                <div style="font-size:18px;font-weight:700;margin-bottom:8px"><%= o.title %></div>
                <div style="display:flex;gap:10px;flex-wrap:wrap">
                  <span class="status status-<%= o.status %>"><%= o.status.replace('_',' ') %></span>
                  <span class="status status-<%= o.escrowStatus %>">🔒 Escrow: <%= o.escrowStatus %></span>
                </div>
              </div>
              <div style="text-align:right">
                <div style="font-family:'Rajdhani',sans-serif;font-size:28px;font-weight:800;color:var(--gold)"><%= o.amount.toLocaleString() %> EGP</div>
                <div style="font-size:12px;color:var(--text-muted)">Ordered: <%= o.createdAt %></div>
              </div>
            </div>
            <!-- Escrow progress -->
            <div style="margin-top:20px">
              <div class="escrow-steps">
                <div class="escrow-step active">
                  <div class="escrow-step-icon">💳</div>
                  <div class="escrow-step-line"></div>
                  <div class="escrow-step-label">Payment Locked</div>
                  <div class="escrow-step-sub">Funds in escrow</div>
                </div>
                <div class="escrow-step <%= o.sellerDelivered ? 'active' : '' %>">
                  <div class="escrow-step-icon">📦</div>
                  <div class="escrow-step-line"></div>
                  <div class="escrow-step-label">Seller Delivered</div>
                  <div class="escrow-step-sub"><%= o.sellerDelivered ? '✅ Done' : 'Waiting...' %></div>
                </div>
                <div class="escrow-step <%= o.buyerConfirmed ? 'active' : '' %>">
                  <div class="escrow-step-icon">✅</div>
                  <div class="escrow-step-line"></div>
                  <div class="escrow-step-label">You Confirm</div>
                  <div class="escrow-step-sub"><%= o.buyerConfirmed ? '✅ Done' : 'Pending' %></div>
                </div>
                <div class="escrow-step <%= o.escrowStatus === 'released' ? 'active' : '' %>">
                  <div class="escrow-step-icon">💰</div>
                  <div class="escrow-step-label">Funds Released</div>
                  <div class="escrow-step-sub"><%= o.escrowStatus === 'released' ? 'Completed' : 'Locked' %></div>
                </div>
              </div>
            </div>
            <div style="display:flex;gap:10px;margin-top:16px;flex-wrap:wrap">
              <% if (o.sellerDelivered && !o.buyerConfirmed) { %>
                <button class="btn btn-green">✅ Confirm Receipt & Release Funds</button>
              <% } %>
              <button class="btn btn-ghost btn-sm">💬 Chat with Seller</button>
              <% if (!o.dispute) { %>
                <button class="btn btn-red btn-sm">⚖️ Open Dispute</button>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="empty-state">
        <div class="empty-state-icon">⏳</div>
        <div class="empty-state-title">No active orders</div>
        <a href="/marketplace" class="btn btn-green" style="margin-top:16px">Browse Marketplace</a>
      </div>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>
