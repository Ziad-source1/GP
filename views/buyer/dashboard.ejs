<%- include('../partials/header') %>

<div class="dashboard-wrap">
  <%- include('../partials/buyer-sidebar') %>
  <div class="dashboard-main">
    <div class="dashboard-header">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px">
        <div>
          <div class="dashboard-title">Welcome back, <%= user.username %> 👾</div>
          <div class="dashboard-sub">Here's what's happening with your account</div>
        </div>
        <a href="/marketplace" class="btn btn-green">🛒 Browse Marketplace</a>
      </div>
    </div>

    <!-- Stat Cards -->
    <div class="stat-cards">
      <div class="stat-card">
        <div class="stat-card-icon">📦</div>
        <div class="stat-card-label">Total Orders</div>
        <div class="stat-card-value text-green"><%= orders.length %></div>
        <div class="stat-card-change up">↑ All time</div>
      </div>
      <div class="stat-card">
        <div class="stat-card-icon">✅</div>
        <div class="stat-card-label">Completed</div>
        <div class="stat-card-value text-green"><%= completed.length %></div>
      </div>
      
      <div class="stat-card">
        <div class="stat-card-icon">💰</div>
        <div class="stat-card-label">Wallet Balance</div>
        <div class="stat-card-value text-green"><%= (user.balance || 0).toLocaleString() %> EGP</div>
      </div>
    </div>

    <!-- Active Orders -->
    <% if (active.length > 0) { %>
      <div class="card" style="margin-bottom:24px">
        <div class="card-header" style="display:flex;align-items:center;justify-content:space-between">
          <span style="font-weight:700">⏳ Active Orders</span>
          <a href="/buyer/active-orders" style="font-size:12px;color:var(--green)">View all →</a>
        </div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Order ID</th><th>Item</th><th>Amount</th><th>Status</th><th>Escrow</th><th>Action</th></tr></thead>
            <tbody>
              <% active.forEach(o => { %>
                <tr>
                  <td class="font-mono text-sm text-green">#<%= o.id %></td>
                  <td><%= o.product_name%></td>
                  <td class="text-gold font-bold"><%= o.total_price.toLocaleString() %> EGP</td>
                  <td><span class="status status-<%= o.is_paid %>"><%= o.is_paid %></span></td>
                  <!-- <td><span class="status status-<%= o.escrowStatus %>"><%= o.escrowStatus %></span></td> -->
                  <!-- <td>
                    <% if (o.sellerDelivered && !o.buyerConfirmed) { %>
                      <button class="btn btn-green btn-sm">✅ Confirm Receipt</button>
                    <% } else { %>
                      <button class="btn btn-ghost btn-sm">💬 Chat</button>
                    <% } %>
                  </td> -->
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

    <!-- Recent Orders -->
    <div class="card">
      <div class="card-header" style="display:flex;align-items:center;justify-content:space-between">
        <span style="font-weight:700">📋 Order History</span>
        <a href="/buyer/orders" style="font-size:12px;color:var(--green)">View all →</a>
      </div>
      <% if (orders.length > 0) { %>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Order ID</th><th>Item</th><th>Amount</th><th>Status</th><th>Date</th></tr></thead>
            <tbody>
              <% orders.forEach(o => { %>
                <tr>
                  <td class="font-mono text-sm text-green">#<%= o.id %></td>
                  <td><%= o.product_name%></td>
                  <td class="text-gold font-bold"><%= o.total_price.toLocaleString() %> EGP</td>
                  <td><span class="status status-<%= o.is_paid %>"><%= o.is_paid %></span></td>
                  <td class="text-muted text-sm"><%= o.created_at %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty-state">
          <div class="empty-state-icon">🛒</div>
          <div class="empty-state-title">No orders yet</div>
          <p>Start browsing to make your first purchase!</p>
          <a href="/marketplace" class="btn btn-green" style="margin-top:16px">Browse Marketplace</a>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
