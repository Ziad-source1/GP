<%- include('../partials/header') %>
<div class="dashboard-wrap">
  <%- include('../partials/admin-sidebar') %>
  <div class="dashboard-main">
    <div class="dashboard-header">
      <div class="dashboard-title">🪪 Seller Verification Review</div>
      <div class="dashboard-sub"><%= pending.length %> applications pending review</div>
    </div>
    <% if (pending.length > 0) { %>
      <% pending.forEach(p => { %>
        <div class="card" style="margin-bottom:16px;border-color:rgba(245,158,11,0.2)">
          <div class="card-header" style="display:flex;align-items:center;justify-content:space-between">
            <div style="display:flex;align-items:center;gap:12px">
              <div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--orange),var(--gold));display:flex;align-items:center;justify-content:center;font-weight:800;color:var(--black)"><%= p.username.charAt(0) %></div>
              <div>
                <div style="font-weight:700"><%= p.username %></div>
                <div style="font-size:12px;color:var(--text-muted)"><%= p.email %></div>
              </div>
            </div>
            <span class="status status-pending">⏳ Pending</span>
          </div>
          <div class="card-body">
            <div class="grid-2" style="gap:16px;margin-bottom:16px">
              <div><div class="form-label">Document Type</div><div class="font-bold"><%= p.docType %></div></div>
              <div><div class="form-label">Submitted</div><div class="text-dim"><%= p.submittedAt %></div></div>
            </div>
            <!-- Mock document previews -->
            <div style="display:flex;gap:12px;margin-bottom:16px">
              <div style="width:120px;height:75px;background:var(--black2);border:2px dashed var(--border2);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:11px;color:var(--text-muted);text-align:center">
                📄<br>ID Front
              </div>
              <div style="width:120px;height:75px;background:var(--black2);border:2px dashed var(--border2);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:11px;color:var(--text-muted);text-align:center">
                📄<br>ID Back
              </div>
              <div style="width:120px;height:75px;background:var(--black2);border:2px dashed var(--border2);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:11px;color:var(--text-muted);text-align:center">
                🤳<br>Selfie
              </div>
            </div>
            <div class="form-group" style="margin-bottom:12px">
              <label class="form-label">Admin Note (optional)</label>
              <input type="text" class="form-control" placeholder="Reason for rejection or internal note...">
            </div>
            <div style="display:flex;gap:10px">
              <form action="/admin/verification/<%= p.id %>/approve" method="POST" style="display:inline">
                <button type="submit" class="btn btn-green">✅ Approve & Verify</button>
              </form>
              <form action="/admin/verification/<%= p.id %>/reject" method="POST" style="display:inline">
                <button type="submit" class="btn btn-red">❌ Reject</button>
              </form>
              <button class="btn btn-ghost btn-sm">📧 Request More Info</button>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="empty-state">
        <div class="empty-state-icon">✅</div>
        <div class="empty-state-title">All caught up!</div>
        <p>No pending verification requests.</p>
      </div>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>
