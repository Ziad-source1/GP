<%- include('../partials/header') %>
<div class="dashboard-wrap">
  <%- include('../partials/admin-sidebar') %>
  <div class="dashboard-main">
    <div class="dashboard-header">
      <div class="dashboard-title">⚙️ Commission Control</div>
      <div class="dashboard-sub">Manage platform commission rates per seller tier</div>
    </div>

    <div class="grid-3" style="gap:20px;margin-bottom:28px">
      <% const tiers = [
        {name:'Basic',color:'var(--text-dim)',current:10,icon:'📋'},
        {name:'Pro',color:'var(--green)',current:7,icon:'⭐'},
        {name:'Elite',color:'var(--gold)',current:4,icon:'👑'}
      ]; %>
      <% tiers.forEach(t => { %>
        <div class="card" style="text-align:center;padding:28px">
          <div style="font-size:32px;margin-bottom:10px"><%= t.icon %></div>
          <div style="font-family:'Rajdhani',sans-serif;font-size:20px;font-weight:800;color:<%= t.color %>"><%= t.name %></div>
          <div style="font-family:'Rajdhani',sans-serif;font-size:48px;font-weight:900;color:<%= t.color %>"><%= t.current %>%</div>
          <div style="font-size:12px;color:var(--text-muted);margin-bottom:16px">current commission</div>
          <div style="display:flex;gap:8px;justify-content:center">
            <input type="number" value="<%= t.current %>" min="0" max="30" style="width:70px;text-align:center;" class="form-control">
            <button class="btn btn-green btn-sm">Save</button>
          </div>
        </div>
      <% }) %>
    </div>

    <div class="card">
      <div class="card-header" style="font-weight:700">📊 Commission Revenue Breakdown</div>
      <div class="card-body">
        <div class="grid-2" style="gap:24px">
          <div>
            <div style="font-size:14px;color:var(--text-dim);margin-bottom:8px">This Month's Commission Income</div>
            <div style="font-family:'Rajdhani',sans-serif;font-size:36px;font-weight:900;color:var(--green)">4,250 EGP</div>
            <div style="font-size:12px;color:var(--text-muted);margin-top:4px">↑ 18% vs last month</div>
          </div>
          <div>
            <div style="margin-bottom:12px">
              <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:6px">
                <span style="color:var(--text-dim)">Basic sellers (10%)</span>
                <span>2,100 EGP</span>
              </div>
              <div class="progress"><div class="progress-bar" style="width:49%"></div></div>
            </div>
            <div style="margin-bottom:12px">
              <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:6px">
                <span style="color:var(--text-dim)">Pro sellers (7%)</span>
                <span>1,470 EGP</span>
              </div>
              <div class="progress"><div class="progress-bar" style="width:35%"></div></div>
            </div>
            <div>
              <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:6px">
                <span style="color:var(--text-dim)">Elite sellers (4%)</span>
                <span>680 EGP</span>
              </div>
              <div class="progress"><div class="progress-bar" style="width:16%"></div></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
