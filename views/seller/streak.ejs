<%- include('../partials/header') %>
<div class="dashboard-wrap">
  <%- include('../partials/seller-sidebar') %>
  <div class="dashboard-main">
    <div class="dashboard-header">
      <div class="dashboard-title">🔥 Trade Streak</div>
      <div class="dashboard-sub">Keep your streak alive to earn bonus rewards</div>
    </div>

    <!-- Current streak hero -->
    <div style="background:linear-gradient(135deg,#0F1E10,#0A1A0C);border:1px solid rgba(0,255,136,0.3);border-radius:20px;padding:40px;text-align:center;margin-bottom:28px;position:relative;overflow:hidden">
      <div style="position:absolute;inset:0;background:radial-gradient(ellipse 60% 60% at 50% 50%,rgba(0,255,136,0.08),transparent)"></div>
      <div style="position:relative;z-index:2">
        <div style="font-size:80px;margin-bottom:16px">🔥</div>
        <div style="font-family:'Rajdhani',sans-serif;font-size:80px;font-weight:900;color:var(--green);line-height:1"><%= streak.current %></div>
        <div style="font-size:20px;font-weight:700;margin-bottom:8px">Day Streak</div>
        <div style="color:var(--text-dim);font-size:14px">Best streak ever: <span style="color:var(--gold);font-weight:700"><%= streak.best %> days</span></div>
      </div>
    </div>

    <!-- Weekly view -->
    <div class="card" style="margin-bottom:24px">
      <div class="card-header" style="font-weight:700">📅 This Week (Complete daily trades to keep your streak)</div>
      <div class="card-body">
        <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:12px;text-align:center">
          <% const dayNames = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun']; %>
          <% dayNames.forEach((day, i) => { %>
            <div>
              <div style="font-size:11px;color:var(--text-muted);margin-bottom:8px"><%= day %></div>
              <div style="width:48px;height:48px;border-radius:12px;margin:0 auto;display:flex;align-items:center;justify-content:center;font-size:18px;
                <%= i < streak.weekly ? 'background:var(--green);color:var(--black);font-weight:900' : i === streak.weekly ? 'background:var(--green-glow);border:2px solid var(--green);animation:pulse 2s infinite' : 'background:var(--card2);border:1px solid var(--border)' %>">
                <%= i < streak.weekly ? '✓' : i === streak.weekly ? '⭐' : '' %>
              </div>
              <div style="font-size:10px;margin-top:6px;color:<%= i < streak.weekly ? 'var(--green)' : i === streak.weekly ? 'var(--green)' : 'var(--text-muted)' %>">
                <%= i < streak.weekly ? 'Done' : i === streak.weekly ? 'Today' : '' %>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>

    <!-- Streak rewards -->
    <div class="card">
      <div class="card-header" style="font-weight:700">🏆 Streak Rewards</div>
      <div class="card-body">
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px">
          <% const rewards = [
            {days:3,label:'3-Day Streak',reward:'Featured slot (1 day)',icon:'⭐'},
            {days:7,label:'7-Day Streak',reward:'1% commission discount',icon:'💸'},
            {days:14,label:'2-Week Streak',reward:'Pro badge for 7 days',icon:'🏅'},
            {days:30,label:'30-Day Legend',reward:'3% commission off + bonus',icon:'👑'}
          ]; %>
          <% rewards.forEach(r => { %>
            <div style="background:var(--card2);border:1px solid var(--border);border-radius:10px;padding:16px;text-align:center;
              <%= streak.current >= r.days ? 'border-color:var(--green-dim);background:var(--green-glow2)' : '' %>">
              <div style="font-size:28px;margin-bottom:8px"><%= r.icon %></div>
              <div style="font-weight:700;font-size:14px;margin-bottom:4px"><%= r.label %></div>
              <div style="font-size:12px;color:var(--text-muted);margin-bottom:10px"><%= r.reward %></div>
              <% if (streak.current >= r.days) { %>
                <span class="tag tag-green">✅ Unlocked</span>
              <% } else { %>
                <span class="tag"><%= r.days - streak.current %> days left</span>
              <% } %>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
