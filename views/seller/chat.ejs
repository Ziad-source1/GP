<%- include('../partials/header') %>
<div class="dashboard-wrap">
  <%- include('../partials/seller-sidebar') %>
  <div class="dashboard-main">
    <div class="dashboard-header">
      <div class="dashboard-title">💬 Chat — Order #<%= order.id %></div>
      <div class="dashboard-sub"><%= order.title %> · Buyer: @<%= order.buyer %></div>
    </div>

    <div class="card" style="max-width:700px">
      <div class="card-body">
        <!-- Messages -->
        <div style="height:350px;overflow-y:auto;display:flex;flex-direction:column;gap:12px;margin-bottom:16px;padding:8px;background:var(--black2);border-radius:8px;border:1px solid var(--border)">
          <% if (messages.length === 0) { %>
            <div style="text-align:center;color:var(--text-muted);margin:auto;font-size:13px">No messages yet. Start the conversation!</div>
          <% } else { %>
            <% messages.forEach(m => { %>
              <div style="display:flex;flex-direction:column;align-items:<%= m.sender_id === user.id ? 'flex-end' : 'flex-start' %>">
                <div style="background:<%= m.sender_id === user.id ? 'var(--green-glow)' : 'var(--card)' %>;border:1px solid var(--border);border-radius:10px;padding:10px 14px;max-width:70%">
                  <div style="font-size:13px"><%= m.message %></div>
                </div>
                <div style="font-size:11px;color:var(--text-muted);margin-top:4px"><%= m.sender_name %> · <%= m.created_at %></div>
              </div>
            <% }) %>
          <% } %>
        </div>

        <!-- Input -->
        <form action="/seller/chat/<%= order.id %>/send" method="POST" style="display:flex;gap:8px">
          <input type="text" name="message" class="form-control" placeholder="Type a message..." required style="flex:1">
          <button type="submit" class="btn btn-green">Send</button>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>