<%- include('../partials/header') %>
<div class="dashboard-wrap">
  <%- include('../partials/seller-sidebar') %>
  <div class="dashboard-main">
    <div class="dashboard-header">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px">
        <div>
          <div class="dashboard-title">📋 Manage Listings</div>
          <div class="dashboard-sub"><%= listings.length %> active listings</div>
        </div>
        <a href="/seller/create-listing" class="btn btn-green">➕ New Listing</a>
      </div>
    </div>

    <% if (listings.length > 0) { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Game</th><th>Title</th><th>Price</th><th>Stock</th><th>Sales</th><th>Status</th><th>Featured</th><th>Actions</th></tr>
          </thead>
          <tbody>
            <% listings.forEach(l => { %>
              <tr>
                <td><span class="tag"><%= l.game %></span></td>
                <td>
                  <div style="font-weight:600;max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= l.title %></div>
                  <div style="font-size:11px;color:var(--text-muted)">ID #<%= l.id %></div>
                </td>
                <td class="text-gold font-bold"><%= l.price.toLocaleString() %> EGP</td>
                <td><span style="color:<%= l.stock < 5 ? 'var(--red)' : 'var(--text)' %>"><%= l.stock %></span></td>
                <td><span style="color:var(--green)"><%= l.sales %></span></td>
                <td><span class="status status-<%= l.status %>"><%= l.status %></span></td>
                <td>
                  <% if (l.featured) { %><span class="nav-badge badge-premium">⭐ Featured</span>
                  <% } else { %><span style="color:var(--text-muted);font-size:12px">—</span><% } %>
                </td>
                <td>
                  <div style="display:flex;gap:6px">
                    <a href="/marketplace/listing/<%= l.id %>" class="btn btn-ghost btn-sm">👁</a>
                    <button class="btn btn-outline btn-sm">✏️</button>
                    <button class="btn btn-red btn-sm">🗑</button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="empty-state">
        <div class="empty-state-icon">📋</div>
        <div class="empty-state-title">No listings yet</div>
        <a href="/seller/create-listing" class="btn btn-green" style="margin-top:16px">Create Your First Listing</a>
      </div>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>
