<%- include('../partials/header') %>
<div class="dashboard-wrap">
  <% if (user.role == 'seller') { %>
    <%- include('../partials/seller-sidebar') %>
    <% } else { %>
      <%- include('../partials/buyer-sidebar') %>
      <% } %>
  <div class="dashboard-main">
    <div class="dashboard-header">
      <div class="dashboard-title">🪪 Seller Verification</div>
      <div class="dashboard-sub">Verify your identity to start selling on LEVEL UP</div>
    </div>

<% if (user && user.is_verified == 1) { %>
  <div class="alert alert-success" style="font-size:15px;padding:16px 20px">
    ✅ Your account is fully verified! You can create listings and sell freely.
  </div>
<% } else if (user && user.is_seller == 1) { %>
  <div class="alert alert-info" style="font-size:15px;padding:16px 20px">
    ⏳ Your documents are under review. An admin will approve within 24–48 hours.
  </div>
<% } else { %>
  <div class="alert alert-info">ℹ️ Verification is required before publishing listings. Review takes 24–48 hours.</div>
<% } %>

    <!-- Steps -->
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:32px">
      <div style="background:var(--green-glow);border:1px solid rgba(0,255,136,0.2);border-radius:var(--radius);padding:20px;text-align:center">
        <div style="font-size:28px;margin-bottom:8px">📄</div>
        <div style="font-weight:700;margin-bottom:4px">1. Upload ID</div>
        <div style="font-size:12px;color:var(--text-muted)">National ID or Passport</div>
      </div>
      <div style="background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:20px;text-align:center">
        <div style="font-size:28px;margin-bottom:8px">🔍</div>
        <div style="font-weight:700;margin-bottom:4px">2. Admin Review</div>
        <div style="font-size:12px;color:var(--text-muted)">24–48 hour review</div>
      </div>
      <div style="background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:20px;text-align:center">
        <div style="font-size:28px;margin-bottom:8px">✅</div>
        <div style="font-weight:700;margin-bottom:4px">3. Start Selling</div>
        <div style="font-size:12px;color:var(--text-muted)">Get your Verified badge</div>
      </div>
    </div>

    <div class="grid-2" style="gap:24px;align-items:start">
      <div class="card">
        <div class="card-header" style="font-weight:700">📤 Submit Documents</div>
        <div class="card-body">
          <form action="/seller/verification" method="POST" enctype="multipart/form-data">
            <div class="form-group">
              <label class="form-label">Document Type</label>
              <select name="docType" class="form-control">
                <option value="national_id">🪪 Egyptian National ID</option>
                <option value="passport">🛂 Passport</option>
                <option value="driving_license">🚗 Driving License</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Full Legal Name (as on document)</label>
              <input type="text" name="fullName" class="form-control" placeholder="Mohamed Ahmed Ibrahim" required>
            </div>
            <div class="form-group">
              <label class="form-label">National ID Number</label>
              <input type="text" name="idNumber" class="form-control" placeholder="XXXXXXXXXXXXX (14 digits)" maxlength="14">
            </div>
            <div class="form-group">
              <label class="form-label">Front of ID / Passport</label>
              <div class="file-upload" onclick="document.getElementById('id-front').click()">
                <input type="file" id="id-front" name="idFront" accept="image/*,application/pdf" style="display:none">
                <div class="file-upload-icon">📸</div>
                <div class="file-upload-text">Click to upload front side · <strong>JPG, PNG or PDF</strong></div>
              </div>
            </div>
            <div class="form-group">
              <label class="form-label">Back of ID (if applicable)</label>
              <div class="file-upload" onclick="document.getElementById('id-back').click()">
                <input type="file" id="id-back" name="idBack" accept="image/*,application/pdf" style="display:none">
                <div class="file-upload-icon">📄</div>
                <div class="file-upload-text">Click to upload back side · <strong>JPG, PNG or PDF</strong></div>
              </div>
            </div>
            <div class="form-group">
              <label class="form-label">Selfie with ID (holding your ID next to your face)</label>
              <div class="file-upload" onclick="document.getElementById('selfie').click()">
                <input type="file" id="selfie" name="selfie" accept="image/*" style="display:none">
                <div class="file-upload-icon">🤳</div>
                <div class="file-upload-text">Click to upload selfie · <strong>Must be clear and well-lit</strong></div>
              </div>
            </div>
            <div class="form-check" style="margin-bottom:20px">
              <input type="checkbox" id="consent" name="consent" required>
              <label class="form-check-label" for="consent">I confirm that this is my real identity and I agree to the <a href="/pages/terms">Terms of Service</a>. I understand my data is encrypted and only used for verification.</label>
            </div>
            <button type="submit" class="btn btn-green btn-block btn-lg">📤 Submit for Verification</button>
          </form>
        </div>
      </div>

      <div>
        <div class="card" style="margin-bottom:16px">
          <div class="card-header" style="font-weight:700">🔒 Privacy & Security</div>
          <div class="card-body">
            <div style="display:flex;flex-direction:column;gap:12px;font-size:13px;color:var(--text-dim)">
              <div style="display:flex;gap:10px"><span style="color:var(--green)">🔐</span><span>All documents are encrypted using AES-256</span></div>
              <div style="display:flex;gap:10px"><span style="color:var(--green)">👁️</span><span>Only authorized admins can view your documents</span></div>
              <div style="display:flex;gap:10px"><span style="color:var(--green)">🗑️</span><span>Documents are deleted after 90 days</span></div>
              <div style="display:flex;gap:10px"><span style="color:var(--green)">🇪🇬</span><span>Compliant with Egyptian data protection laws</span></div>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-header" style="font-weight:700">✅ After Verification</div>
          <div class="card-body">
            <div style="display:flex;flex-direction:column;gap:12px;font-size:13px;color:var(--text-dim)">
              <div style="display:flex;gap:10px"><span>🏷️</span><span>Verified Seller badge on your profile</span></div>
              <div style="display:flex;gap:10px"><span>📋</span><span>Unlimited listing creation</span></div>
              <div style="display:flex;gap:10px"><span>💰</span><span>Withdrawals up to 50,000 EGP/month</span></div>
              <div style="display:flex;gap:10px"><span>⭐</span><span>Eligible for Premium Seller upgrade</span></div>
              <div style="display:flex;gap:10px"><span>🔗</span><span>Access to Affiliate Program</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
