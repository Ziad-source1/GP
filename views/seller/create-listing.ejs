<%- include('../partials/header') %>
<div class="dashboard-wrap">
  <%- include('../partials/seller-sidebar') %>
  <div class="dashboard-main">
    <div class="dashboard-header">
      <div class="dashboard-title">➕ Create New Listing</div>
      <div class="dashboard-sub">Fill in the details to publish your listing</div>
    </div>

    <form action="/seller/create-listing" method="POST" enctype="multipart/form-data">
      <div class="grid-2" style="gap:24px;align-items:start">
        <!-- LEFT -->
        <div>
          <div class="card" style="margin-bottom:20px">
            <div class="card-header" style="font-weight:700">📋 Listing Details</div>
            <div class="card-body">
              <div class="form-group">
                <label class="form-label">Category *</label>
                <select name="category" class="form-control" required>
                  <option value="">Select Category</option>
                  <option value="currency">💰 Game Currency</option>
                  <option value="accounts">🎮 Game Accounts</option>
                  <option value="topups">⚡ Top-Ups</option>
                  <option value="items">⚔️ In-Game Items</option>
                  <option value="boosting">🚀 Boosting Services</option>
                  <option value="giftcards">🎁 Gift Cards</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label">Game / Platform *</label>
                <input type="text" name="game" class="form-control" placeholder="e.g. Free Fire, PUBG Mobile, PlayStation..." required>
              </div>
              <div class="form-group">
                <label class="form-label">Listing Title *</label>
                <input type="text" name="title" class="form-control" placeholder="e.g. 10,000 Free Fire Diamonds — Instant Delivery" required maxlength="100">
                <div class="form-hint">Be specific. Clear titles get more clicks.</div>
              </div>
              <div class="form-group">
                <label class="form-label">Description *</label>
                <textarea name="description" class="form-control" rows="5" required placeholder="Describe what the buyer gets, delivery method, any requirements..."></textarea>
              </div>
              <div class="form-group">
                <label class="form-label">Tags (comma-separated)</label>
                <input type="text" name="tags" class="form-control" placeholder="e.g. instant, safe, cheap">
                <div class="form-hint">Add up to 5 tags to help buyers find your listing</div>
              </div>
            </div>
          </div>

          <div class="card">
            <div class="card-header" style="font-weight:700">📸 Listing Image</div>
            <div class="card-body">
              <div class="file-upload" onclick="document.getElementById('listing-img').click()">
                <input type="file" id="listing-img" name="image" accept="image/*" style="display:none">
                <div class="file-upload-icon">🖼️</div>
                <div class="file-upload-text">Click to upload listing image · <strong>JPG/PNG, max 2MB</strong></div>
              </div>
              <div class="form-hint" style="margin-top:8px">Recommended: 600×400px. Clear, gaming-related image.</div>
            </div>
          </div>
        </div>

        <!-- RIGHT -->
        <div>
          <div class="card" style="margin-bottom:20px">
            <div class="card-header" style="font-weight:700">💰 Pricing & Stock</div>
            <div class="card-body">
              <div class="form-group">
                <label class="form-label">Price (EGP) *</label>
                <div class="input-group">
                  <input type="number" name="price" class="form-control" placeholder="e.g. 450" min="5" required>
                  <span class="input-suffix">EGP</span>
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label">Stock / Quantity</label>
                  <input type="number" name="stock" class="form-control" placeholder="e.g. 50" min="1" value="1">
                </div>
                <div class="form-group">
                  <label class="form-label">Min Order</label>
                  <input type="number" name="minOrder" class="form-control" placeholder="1" min="1" value="1">
                </div>
              </div>
              <div class="form-group">
                <label class="form-label">Max Order per Buyer</label>
                <input type="number" name="maxOrder" class="form-control" placeholder="e.g. 10" min="1" value="10">
              </div>
            </div>
          </div>

          <div class="card" style="margin-bottom:20px">
            <div class="card-header" style="font-weight:700">⚡ Delivery Settings</div>
            <div class="card-body">
              <div class="form-group">
                <label class="form-label">Delivery Time *</label>
                <select name="deliveryTime" class="form-control" required>
                  <option value="Instant">⚡ Instant</option>
                  <option value="5 min">⏱ 5 minutes</option>
                  <option value="10 min">⏱ 10 minutes</option>
                  <option value="15 min">⏱ 15 minutes</option>
                  <option value="30 min">⏱ 30 minutes</option>
                  <option value="1 hour">🕐 1 hour</option>
                  <option value="1-3 days">📅 1–3 days</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label">Delivery Method / Instructions</label>
                <textarea name="deliveryInstructions" class="form-control" rows="3" placeholder="Describe how you'll deliver (e.g. need player ID, top-up via account sharing, etc.)"></textarea>
              </div>
            </div>
          </div>

          <div class="card" style="margin-bottom:20px">
            <div class="card-header" style="font-weight:700">⚙️ Listing Options</div>
            <div class="card-body">
              <div style="display:flex;flex-direction:column;gap:12px">
                <label class="form-check">
                  <input type="checkbox" name="autoDeliver" checked>
                  <span class="form-check-label">Enable auto-delivery (if applicable)</span>
                </label>
                <label class="form-check">
                  <input type="checkbox" name="featured">
                  <span class="form-check-label">Request featured placement (Premium only)</span>
                </label>
              </div>
            </div>
          </div>

          <!-- Preview commission -->
          <div style="background:var(--green-glow);border:1px solid rgba(0,255,136,0.2);border-radius:10px;padding:16px;margin-bottom:20px">
            <div style="font-weight:700;color:var(--green);margin-bottom:10px">💸 Commission Preview</div>
            <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:6px">
              <span style="color:var(--text-dim)">Your tier</span>
              <span class="tag tag-green"><%= user && user.badge === 'premium' ? '⭐ Premium — 7%' : '📋 Basic — 10%' %></span>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:6px">
              <span style="color:var(--text-dim)">Listing at 450 EGP</span>
              <span>450 EGP</span>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:13px;color:var(--red)">
              <span>Commission (<%= user && user.badge === 'premium' ? '7' : '10' %>%)</span>
              <span>– <%= user && user.badge === 'premium' ? '31.50' : '45' %> EGP</span>
            </div>
            <div class="divider" style="margin:10px 0"></div>
            <div style="display:flex;justify-content:space-between;font-weight:700;color:var(--green)">
              <span>You receive</span>
              <span><%= user && user.badge === 'premium' ? '418.50' : '405' %> EGP</span>
            </div>
            <a href="/seller/premium" style="font-size:12px;color:var(--gold);display:block;margin-top:10px">⭐ Upgrade to pay less commission →</a>
          </div>

          <button type="submit" class="btn btn-green btn-block btn-lg">🚀 Publish Listing</button>
          <div style="font-size:12px;color:var(--text-muted);text-align:center;margin-top:10px">Listings are reviewed before going live. Usually within 30 minutes.</div>
        </div>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
