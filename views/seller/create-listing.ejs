<%- include('../partials/header', { user: user }) %>
<div class="dashboard-wrap">
  <%- include('../partials/seller-sidebar', { user: user }) %>
  <div class="dashboard-main">
    <div class="dashboard-header">
      <div class="dashboard-title">➕ Create New Product</div>
      <div class="dashboard-sub">List your product in the marketplace</div>
    </div>

    <% if (locals.error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <% if (locals.success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>

    <form action="/seller/create-listing" method="POST" enctype="multipart/form-data">
      <div class="grid-2" style="gap:24px;align-items:start">
        <!-- LEFT COLUMN -->
        <div>
          <div class="card" style="margin-bottom:20px">
            <div class="card-header" style="font-weight:700">📋 Product Details</div>
            <div class="card-body">
              <div class="form-group">
                <label class="form-label">Product Name *</label>
                <input type="text" name="name" class="form-control" placeholder="e.g. FIFA Coins, Fortnite Account" required maxlength="100">
                <div class="form-hint">Clear product name helps buyers find you</div>
              </div>

              <div class="form-group">
                <label class="form-label">Category *</label>
                <select name="category" class="form-control" required>
                  <option value="">Select Category</option>
                  <option value="currency">💰 Game Currency</option>
                  <option value="accounts">🎮 Game Accounts</option>
                  <option value="topups">⚡ Top-Ups</option>
                  <option value="items">⚔️ In-Game Items</option>
                  <option value="boosting">🚀 Boosting Services</option>
                  <option value="giftcards">🎁 Gift Cards</option>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label">Game / Platform *</label>
                <input type="text" name="game" class="form-control" placeholder="e.g. Free Fire, PUBG Mobile, PlayStation..." required>
              </div>

              <div class="form-group">
                <label class="form-label">Product Description *</label>
                <textarea name="description" class="form-control" rows="6" required placeholder="Describe what the buyer gets, delivery method, any requirements..."></textarea>
                <div class="form-hint">Be detailed. Include what makes your product special.</div>
              </div>

              <div class="form-group">
                <label class="form-label">Tags (comma-separated)</label>
                <input type="text" name="tags" class="form-control" placeholder="e.g. instant, safe, cheap, 24/7 support">
                <div class="form-hint">Add up to 5 tags to help buyers find your listing</div>
              </div>
            </div>
          </div>

          <div class="card">
            <div class="card-header" style="font-weight:700">📸 Product Image</div>
            <div class="card-body">
              <div class="file-upload" onclick="document.getElementById('product-img').click()">
                <input type="file" id="product-img" name="image" accept="image/*" style="display:none">
                <div class="file-upload-icon">🖼️</div>
                <div class="file-upload-text">Click to upload product image · <strong>JPG/PNG, max 2MB</strong></div>
              </div>
              <div class="form-hint" style="margin-top:8px">Recommended: 600×400px. Clear, gaming-related image.</div>
              <div id="imagePreview" style="margin-top: 10px; display: none;">
                <img id="previewImg" src="#" alt="Preview" style="max-width: 100%; border-radius: 8px;">
              </div>
            </div>
          </div>
        </div>

        <!-- RIGHT COLUMN -->
        <div>
          <div class="card" style="margin-bottom:20px">
            <div class="card-header" style="font-weight:700">💰 Pricing & Stock</div>
            <div class="card-body">
              <div class="form-group">
                <label class="form-label">Price (EGP) *</label>
                <div class="input-group">
                  <input type="number" name="price" id="price" class="form-control" placeholder="e.g. 450" min="5" required step="0.01">
                  <span class="input-suffix">EGP</span>
                </div>
              </div>

              <div class="form-group">
                <label class="form-label">Stock / Quantity *</label>
                <input type="number" name="stock" class="form-control" placeholder="e.g. 50" min="1" required value="1">
                <div class="form-hint">How many units are available for sale</div>
              </div>

              <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <div class="form-group">
                  <label class="form-label">Min Order</label>
                  <input type="number" name="minOrder" class="form-control" placeholder="1" min="1" value="1">
                </div>
                <div class="form-group">
                  <label class="form-label">Max Order</label>
                  <input type="number" name="maxOrder" class="form-control" placeholder="e.g. 10" min="1" value="10">
                </div>
              </div>
            </div>
          </div>

          <div class="card" style="margin-bottom:20px">
            <div class="card-header" style="font-weight:700">⚡ Delivery Settings</div>
            <div class="card-body">
              <div class="form-group">
                <label class="form-label">Delivery Time *</label>
                <select name="deliveryTime" class="form-control" required>
                  <option value="Instant">⚡ Instant</option>
                  <option value="5 min">⏱ 5 minutes</option>
                  <option value="10 min">⏱ 10 minutes</option>
                  <option value="15 min">⏱ 15 minutes</option>
                  <option value="30 min">⏱ 30 minutes</option>
                  <option value="1 hour">🕐 1 hour</option>
                  <option value="1-3 days">📅 1–3 days</option>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label">Delivery Instructions</label>
                <textarea name="deliveryInstructions" class="form-control" rows="3" placeholder="Describe how you'll deliver (e.g. need player ID, top-up via account sharing, etc.)"></textarea>
                <div class="form-hint">Buyers will see these instructions after purchase</div>
              </div>
            </div>
          </div>

          <div class="card" style="margin-bottom:20px">
            <div class="card-header" style="font-weight:700">⚙️ Listing Options</div>
            <div class="card-body">
              <div style="display:flex;flex-direction:column;gap:12px">
                <label class="form-check">
                  <input type="checkbox" name="autoDeliver" value="1" checked>
                  <span class="form-check-label">Enable auto-delivery (if applicable)</span>
                </label>
                <label class="form-check">
                  <input type="checkbox" name="featured" value="1">
                  <span class="form-check-label">Request featured placement (Premium only)</span>
                </label>
                <label class="form-check">
                  <input type="checkbox" name="insurance" value="1" checked>
                  <span class="form-check-label">Include buyer protection insurance</span>
                </label>
              </div>
            </div>
          </div>

          <!-- Commission Preview (Live) -->
          <div style="background:var(--green-glow);border:1px solid rgba(0,255,136,0.2);border-radius:10px;padding:16px;margin-bottom:20px">
            <div style="font-weight:700;color:var(--green);margin-bottom:10px">💸 Commission Preview</div>
            <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:6px">
              <span style="color:var(--text-dim)">Your tier</span>
              <span class="tag tag-green">📋 Basic — 10%</span>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:6px">
              <span style="color:var(--text-dim)">Listing price</span>
              <span id="pricePreview">0 EGP</span>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:13px;color:var(--red)">
              <span>Commission (10%)</span>
              <span id="commissionPreview">0 EGP</span>
            </div>
            <div class="divider" style="margin:10px 0"></div>
            <div style="display:flex;justify-content:space-between;font-weight:700;color:var(--green)">
              <span>You receive</span>
              <span id="youReceive">0 EGP</span>
            </div>
            <a href="/seller/premium" style="font-size:12px;color:var(--gold);display:block;margin-top:10px">⭐ Upgrade to pay less commission →</a>
          </div>

          <button type="submit" class="btn btn-green btn-block btn-lg">🚀 Publish Product</button>
          <div style="font-size:12px;color:var(--text-muted);text-align:center;margin-top:10px">Your product will be reviewed and visible in the marketplace</div>
        </div>
      </div>
    </form>
  </div>
</div>

<script>
  // Image preview
  document.getElementById('product-img').addEventListener('change', function(e) {
    const file = e.target.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = function(e) {
        document.getElementById('previewImg').src = e.target.result;
        document.getElementById('imagePreview').style.display = 'block';
      }
      reader.readAsDataURL(file);
    }
  });

  // Live commission preview
  const priceInput = document.getElementById('price');
  const pricePreview = document.getElementById('pricePreview');
  const commissionPreview = document.getElementById('commissionPreview');
  const youReceive = document.getElementById('youReceive');

  function updatePreview() {
    const price = parseFloat(priceInput.value) || 0;
    const commission = price * 0.10;
    const receive = price - commission;
    
    pricePreview.textContent = price.toLocaleString() + ' EGP';
    commissionPreview.textContent = commission.toLocaleString() + ' EGP';
    youReceive.textContent = receive.toLocaleString() + ' EGP';
  }

  priceInput.addEventListener('input', updatePreview);
  updatePreview();
</script>

<style>
  .form-group {
    margin-bottom: 20px;
  }
  .form-label {
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
    color: var(--text-color);
  }
  .form-control {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-card);
    color: var(--text-color);
    font-size: 14px;
    transition: all 0.2s;
  }
  .form-control:focus {
    outline: none;
    border-color: var(--green);
    box-shadow: 0 0 0 2px rgba(0, 255, 136, 0.1);
  }
  .form-hint {
    display: block;
    margin-top: 5px;
    font-size: 12px;
    color: var(--text-muted);
  }
  .input-group {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .input-group .form-control {
    flex: 1;
  }
  .input-suffix {
    padding: 10px 12px;
    background: var(--bg-dark);
    border-radius: 8px;
    font-size: 14px;
    color: var(--text-muted);
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .file-upload {
    border: 2px dashed var(--border);
    border-radius: 8px;
    padding: 40px;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s;
  }
  .file-upload:hover {
    border-color: var(--green);
    background: rgba(0, 255, 136, 0.05);
  }
  .file-upload-icon {
    font-size: 48px;
    margin-bottom: 10px;
  }
  .file-upload-text {
    font-size: 14px;
    color: var(--text-muted);
  }
  .form-check {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
  }
  .form-check input {
    width: 18px;
    height: 18px;
    cursor: pointer;
  }
  .form-check-label {
    cursor: pointer;
  }
  .btn-block {
    width: 100%;
  }
  .btn-lg {
    padding: 14px 24px;
    font-size: 16px;
  }
  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  @media (max-width: 768px) {
    .grid-2 {
      grid-template-columns: 1fr;
    }
    .form-row {
      grid-template-columns: 1fr;
    }
  }
  .alert {
    padding: 12px 16px;
    border-radius: 8px;
    margin-bottom: 20px;
  }
  .alert-error {
    background: #fee2e2;
    color: #dc2626;
    border: 1px solid #fecaca;
  }
  .alert-success {
    background: #d1fae5;
    color: #065f46;
    border: 1px solid #a7f3d0;
  }
</style>

<%- include('../partials/footer') %>