<%- include('../partials/header') %>
<div class="dashboard-wrap">
  <%- include('../partials/seller-sidebar') %>
  <div class="dashboard-main">
    <div class="dashboard-header">
      <div class="dashboard-title">🎯 Trade Goal Tracker</div>
      <div class="dashboard-sub">Set monthly targets and earn rewards on completion</div>
    </div>

    <div class="grid-2" style="gap:24px;margin-bottom:24px">
      <!-- Revenue goal -->
      <div class="card" style="border-color:rgba(0,255,136,0.2)">
        <div class="card-header" style="font-weight:700;color:var(--green)">💰 Revenue Goal</div>
        <div class="card-body">
          <div style="text-align:center;padding:16px 0">
            <div style="font-family:'Rajdhani',sans-serif;font-size:48px;font-weight:900;color:var(--green)"><%= goal.current.toLocaleString() %></div>
            <div style="font-size:16px;color:var(--text-dim)">of <%= goal.target.toLocaleString() %> EGP goal</div>
          </div>
          <div class="progress progress-lg" style="margin-bottom:10px">
            <div class="progress-bar" data-width="<%= Math.round(goal.current/goal.target*100) %>%" style="width:<%= Math.round(goal.current/goal.target*100) %>%"></div>
          </div>
          <div style="display:flex;justify-content:space-between;font-size:13px">
            <span style="color:var(--green);font-weight:700"><%= Math.round(goal.current/goal.target*100) %>% complete</span>
            <span style="color:var(--text-muted)"><%= (goal.target - goal.current).toLocaleString() %> EGP remaining</span>
          </div>
        </div>
      </div>

      <!-- Trade count goal -->
      <div class="card" style="border-color:rgba(212,175,55,0.2)">
        <div class="card-header" style="font-weight:700;color:var(--gold)">📦 Trade Count Goal</div>
        <div class="card-body">
          <div style="text-align:center;padding:16px 0">
            <div style="font-family:'Rajdhani',sans-serif;font-size:48px;font-weight:900;color:var(--gold)"><%= goal.trades.current %></div>
            <div style="font-size:16px;color:var(--text-dim)">of <%= goal.trades.target %> trades goal</div>
          </div>
          <div class="progress progress-lg progress-gold" style="margin-bottom:10px">
            <div class="progress-bar" style="width:<%= Math.round(goal.trades.current/goal.trades.target*100) %>%;background:linear-gradient(90deg,var(--gold),var(--orange))"></div>
          </div>
          <div style="display:flex;justify-content:space-between;font-size:13px">
            <span style="color:var(--gold);font-weight:700"><%= Math.round(goal.trades.current/goal.trades.target*100) %>% complete</span>
            <span style="color:var(--text-muted)"><%= goal.trades.target - goal.trades.current %> trades remaining</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Set new goals -->
    <div class="card" style="margin-bottom:24px">
      <div class="card-header" style="font-weight:700">⚙️ Set Goals for Next Month</div>
      <div class="card-body">
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Revenue Target (EGP)</label>
            <input type="number" class="form-control" placeholder="e.g. 15000" value="<%= goal.target %>">
          </div>
          <div class="form-group">
            <label class="form-label">Trade Count Target</label>
            <input type="number" class="form-control" placeholder="e.g. 60" value="<%= goal.trades.target %>">
          </div>
        </div>
        <button class="btn btn-green">💾 Save Goals</button>
      </div>
    </div>

    <!-- Goal rewards -->
    <div class="card">
      <div class="card-header" style="font-weight:700">🏆 Goal Completion Rewards</div>
      <div class="card-body">
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px">
          <% const goalRewards = [
            {pct:25,label:'25% Complete',reward:'Progress badge',icon:'🌱'},
            {pct:50,label:'50% Complete',reward:'Streak bonus day',icon:'⚡'},
            {pct:75,label:'75% Complete',reward:'0.5% commission off',icon:'💸'},
            {pct:100,label:'100% — GOAL!',reward:'2% commission off + Elite badge',icon:'👑'}
          ]; %>
          <% goalRewards.forEach(r => { %>
            <% const pct = Math.round(goal.current/goal.target*100); %>
            <div style="background:var(--card2);border:1px solid var(--border);border-radius:10px;padding:16px;text-align:center;
              <%= pct >= r.pct ? 'border-color:var(--green-dim);background:var(--green-glow2)' : '' %>">
              <div style="font-size:28px;margin-bottom:8px"><%= r.icon %></div>
              <div style="font-weight:700;margin-bottom:4px"><%= r.label %></div>
              <div style="font-size:12px;color:var(--text-muted);margin-bottom:10px"><%= r.reward %></div>
              <% if (pct >= r.pct) { %>
                <span class="tag tag-green">✅ Unlocked</span>
              <% } else { %>
                <div class="progress" style="height:4px"><div class="progress-bar" style="width:<%= Math.min(100,Math.round(pct/r.pct*100)) %>%"></div></div>
              <% } %>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
