<%- include('../partials/header') %>
<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--black2)">
  <div style="background:var(--card);border:1px solid var(--border);border-radius:20px;padding:48px;max-width:420px;width:100%">
    <div style="text-align:center;margin-bottom:28px">
      <div style="font-size:48px;margin-bottom:12px">🔑</div>
      <h2 style="font-size:26px;font-weight:800">Reset Password</h2>
      <p style="color:var(--text-dim);font-size:14px;margin-top:6px">Enter your email to receive reset instructions</p>
    </div>
    <form action="/auth/forgot" method="POST">
      <div class="form-group">
        <label class="form-label">Email Address</label>
        <input type="email" name="email" class="form-control" placeholder="your@email.com" required>
      </div>
      <button type="submit" class="btn btn-green btn-block">Send Reset Link</button>
    </form>
    <div class="auth-link" style="margin-top:20px;text-align:center">
      <a href="/auth/login">← Back to Login</a>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
