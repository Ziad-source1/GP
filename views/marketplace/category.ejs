<%- include('../partials/header') %>

<div class="page-header">
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Home</a><span class="breadcrumb-sep">›</span>
      <a href="/marketplace">Marketplace</a><span class="breadcrumb-sep">›</span>
      <span class="breadcrumb-current"><%= category.name %></span>
    </div>
    <h1 class="page-title"><%= category.icon %> <%= category.name %></h1>
    <p class="page-subtitle"><%= category.count.toLocaleString() %> verified listings available</p>
  </div>
</div>

<div class="container" style="padding-top:32px;padding-bottom:64px">
  <!-- Sub categories pills -->
  <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:24px">
    <% categories.forEach(cat => { %>
      <a href="/marketplace/category/<%= cat.id %>" 
         class="filter-tag <%= cat.id === category.id ? 'active' : '' %>">
        <%= cat.icon %> <%= cat.name %>
      </a>
    <% }) %>
  </div>

  <% if (listings.length > 0) { %>
    <div class="grid-auto">
      <% listings.forEach((listing, i) => { %>
        <div class="listing-card animate-fade-up" style="animation-delay:<%= i * 0.06 %>s">
          <div class="listing-card-img" style="background:linear-gradient(135deg,var(--card2),#0A1020)">
            <%= category.icon %>
            <% if (listing.featured) { %><span class="listing-card-badge badge-featured">⭐</span><% } %>
          </div>
          <div class="listing-card-body">
            <div class="listing-game"><%= listing.game %></div>
            <div class="listing-title"><%= listing.title %></div>
            <div class="listing-seller">
              <div class="listing-seller-dot"><%= listing.sellerName.charAt(0) %></div>
              <span><%= listing.sellerName %></span>
              <% if (listing.sellerBadge === 'premium') { %><span class="tag tag-green" style="font-size:10px">PRO</span><% } %>
              <span style="color:var(--gold);font-size:12px">★ <%= listing.sellerRating %></span>
            </div>
            <div class="listing-meta">
              <span>⚡ <%= listing.deliveryTime %></span>
              <span>📦 <%= listing.stock %> in stock</span>
            </div>
          </div>
          <div class="listing-footer">
            <div class="listing-price"><%= listing.price.toLocaleString() %> <span>EGP</span></div>
            <a href="/marketplace/listing/<%= listing.id %>" class="btn btn-green btn-sm">Buy Now</a>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state">
      <div class="empty-state-icon"><%= category.icon %></div>
      <div class="empty-state-title">No listings in <%= category.name %> yet</div>
      <p>Be the first to list in this category!</p>
      <% if (user && (user.role === 'seller' || user.role === 'admin')) { %>
        <a href="/seller/create-listing" class="btn btn-green" style="margin-top:16px">Create Listing</a>
      <% } %>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
