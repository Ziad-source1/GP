<%- include('../partials/header') %>

<div class="page-header" style="text-align:center">
  <div class="container">
    <div class="section-eyebrow" style="display:inline-block">Unlock Your Potential</div>
    <h1 class="page-title">Go <span class="text-gold">Premium</span> — Sell More, Earn More</h1>
    <p class="page-subtitle" style="margin:0 auto">Lower commissions, higher visibility, priority support. Built for serious sellers.</p>
  </div>
</div>

<div class="container" style="padding:64px 24px">

  <!-- Benefits hero -->
  <div class="grid-4" style="gap:20px;margin-bottom:56px">
    <% const benefits = [
      {icon:'💸',title:'Lower Commission',body:'Pay as little as 4% vs 10% on Basic'},
      {icon:'🔝',title:'Top Ranking',body:'Your listings appear first in search'},
      {icon:'⭐',title:'Premium Badge',body:'Verified premium badge builds trust fast'},
      {icon:'📊',title:'Full Analytics',body:'Deep insights on your sales & traffic'}
    ]; %>
    <% benefits.forEach(b => { %>
      <div style="text-align:center;background:var(--card);border:1px solid var(--border);border-radius:16px;padding:28px">
        <div style="font-size:36px;margin-bottom:12px"><%= b.icon %></div>
        <h3 style="font-size:16px;font-weight:800;margin-bottom:6px"><%= b.title %></h3>
        <p style="font-size:13px;color:var(--text-dim)"><%= b.body %></p>
      </div>
    <% }) %>
  </div>

  <!-- Plans -->
  <h2 style="text-align:center;font-size:32px;font-weight:900;margin-bottom:40px">Choose Your Plan</h2>
  <div class="plans-grid">
    <% plans.forEach((plan, i) => { %>
      <div class="plan-card <%= i === 1 ? 'featured' : '' %>">
        <% if (i === 1) { %><div class="plan-badge">⭐ Most Popular</div><% } %>
        <% if (i === 2) { %><div class="plan-badge" style="background:var(--purple)">👑 Best Value</div><% } %>
        <div>
          <div class="plan-name"><%= plan.name %></div>
          <div class="plan-price"><%= plan.price === 0 ? 'Free' : plan.price.toLocaleString() %><% if (plan.price > 0) { %><span>EGP/month</span><% } %></div>
          <div class="plan-commission">✅ <%= plan.commission %>% commission on sales</div>
        </div>
        <ul class="plan-features">
          <% plan.features.forEach(f => { %><li class="plan-feature"><%= f %></li><% }) %>
        </ul>
        <a href="<%= plan.price === 0 ? '/auth/register' : '/seller/premium' %>" class="btn <%= i === 2 ? 'btn-gold' : i === 1 ? 'btn-green' : 'btn-ghost' %> btn-block btn-lg">
          <%= plan.price === 0 ? 'Get Started Free' : `Upgrade to ${plan.name}` %>
        </a>
      </div>
    <% }) %>
  </div>

  <!-- Savings calculator -->
  <div style="background:var(--card2);border:1px solid var(--border);border-radius:20px;padding:40px;margin-top:56px">
    <h3 style="font-size:24px;font-weight:900;text-align:center;margin-bottom:8px">💰 Calculate Your Savings</h3>
    <p style="color:var(--text-dim);text-align:center;font-size:14px;margin-bottom:28px">See how much you save with Premium vs Basic</p>
    <div style="max-width:500px;margin:0 auto">
      <div class="form-group">
        <label class="form-label">Monthly Revenue (EGP): <span id="rev-display">5,000</span></label>
        <input type="range" id="revenue-slider" min="500" max="50000" value="5000" step="500" class="w-full" style="accent-color:var(--green);width:100%">
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-top:20px">
        <div style="text-align:center;background:var(--card);border:1px solid var(--border);border-radius:10px;padding:16px">
          <div style="font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px">Basic (10%)</div>
          <div style="font-family:'Rajdhani',sans-serif;font-size:22px;font-weight:800;color:var(--red)" id="basic-fee">500 EGP</div>
          <div style="font-size:11px;color:var(--text-muted)">you keep</div>
          <div style="font-family:'Rajdhani',sans-serif;font-size:18px;font-weight:700;color:var(--text)" id="basic-keep">4,500</div>
        </div>
        <div style="text-align:center;background:var(--green-glow2);border:1px solid rgba(0,255,136,0.2);border-radius:10px;padding:16px">
          <div style="font-size:11px;color:var(--green);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px">Pro (7%)</div>
          <div style="font-family:'Rajdhani',sans-serif;font-size:22px;font-weight:800;color:var(--orange)" id="pro-fee">350 EGP</div>
          <div style="font-size:11px;color:var(--text-muted)">you keep</div>
          <div style="font-family:'Rajdhani',sans-serif;font-size:18px;font-weight:700;color:var(--green)" id="pro-keep">4,650</div>
        </div>
        <div style="text-align:center;background:var(--gold-glow);border:1px solid rgba(212,175,55,0.2);border-radius:10px;padding:16px">
          <div style="font-size:11px;color:var(--gold);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px">Elite (4%)</div>
          <div style="font-family:'Rajdhani',sans-serif;font-size:22px;font-weight:800;color:var(--orange)" id="elite-fee">200 EGP</div>
          <div style="font-size:11px;color:var(--text-muted)">you keep</div>
          <div style="font-family:'Rajdhani',sans-serif;font-size:18px;font-weight:700;color:var(--gold)" id="elite-keep">4,800</div>
        </div>
      </div>
      <div style="text-align:center;margin-top:16px;font-size:13px;color:var(--text-dim)">
        Elite saves you <span id="elite-savings" style="color:var(--gold);font-weight:700">300 EGP/month</span> vs Basic
      </div>
    </div>
  </div>
</div>

<script>
const slider = document.getElementById('revenue-slider');
const revDisplay = document.getElementById('rev-display');
const update = () => {
  const rev = parseInt(slider.value);
  revDisplay.textContent = rev.toLocaleString();
  const basicFee = Math.round(rev * 0.10);
  const proFee = Math.round(rev * 0.07);
  const eliteFee = Math.round(rev * 0.04);
  document.getElementById('basic-fee').textContent = basicFee.toLocaleString() + ' EGP';
  document.getElementById('pro-fee').textContent = proFee.toLocaleString() + ' EGP';
  document.getElementById('elite-fee').textContent = eliteFee.toLocaleString() + ' EGP';
  document.getElementById('basic-keep').textContent = (rev - basicFee).toLocaleString();
  document.getElementById('pro-keep').textContent = (rev - proFee).toLocaleString();
  document.getElementById('elite-keep').textContent = (rev - eliteFee).toLocaleString();
  document.getElementById('elite-savings').textContent = (basicFee - eliteFee).toLocaleString() + ' EGP/month';
};
if (slider) slider.addEventListener('input', update);
</script>

<%- include('../partials/footer') %>
