<%- include('../partials/header') %>

<div class="page-header" style="text-align:center">
  <div class="container">
    <div class="section-eyebrow" style="display:inline-block">Earn While You Play</div>
    <h1 class="page-title">🔗 Affiliate Program</h1>
    <p class="page-subtitle" style="margin:0 auto">Refer friends to LEVEL UP and earn for every signup and purchase</p>
  </div>
</div>

<div class="container" style="padding:64px 24px">

  <!-- Earnings showcase -->
  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-bottom:56px;text-align:center">
    <div style="background:var(--green-glow);border:1px solid rgba(0,255,136,0.25);border-radius:16px;padding:36px">
      <div style="font-size:40px;margin-bottom:12px">👤</div>
      <div style="font-family:'Rajdhani',sans-serif;font-size:48px;font-weight:900;color:var(--green)">5 EGP</div>
      <div style="font-weight:700;margin-bottom:6px">Per Signup</div>
      <div style="font-size:13px;color:var(--text-dim)">Every new user who registers via your link</div>
    </div>
    <div style="background:var(--gold-glow);border:1px solid rgba(212,175,55,0.25);border-radius:16px;padding:36px">
      <div style="font-size:40px;margin-bottom:12px">🛒</div>
      <div style="font-family:'Rajdhani',sans-serif;font-size:48px;font-weight:900;color:var(--gold)">2%</div>
      <div style="font-weight:700;margin-bottom:6px">First Purchase</div>
      <div style="font-size:13px;color:var(--text-dim)">2% commission on each referral's first order</div>
    </div>
    <div style="background:rgba(168,85,247,0.1);border:1px solid rgba(168,85,247,0.25);border-radius:16px;padding:36px">
      <div style="font-size:40px;margin-bottom:12px">♾️</div>
      <div style="font-family:'Rajdhani',sans-serif;font-size:48px;font-weight:900;color:var(--purple)">∞</div>
      <div style="font-weight:700;margin-bottom:6px">No Limit</div>
      <div style="font-size:13px;color:var(--text-dim)">Refer as many people as you want</div>
    </div>
  </div>

  <!-- How it works -->
  <div style="margin-bottom:56px">
    <h2 style="font-size:28px;font-weight:900;text-align:center;margin-bottom:40px">How It Works</h2>
    <div class="grid-4" style="gap:20px;text-align:center">
      <% const steps = [
        {n:1,icon:'🔗',title:'Get Your Link',body:'Sign up and get your unique referral link from the Affiliate dashboard'},
        {n:2,icon:'📢',title:'Share Everywhere',body:'Post it on Facebook, gaming groups, WhatsApp, Discord — anywhere'},
        {n:3,icon:'👥',title:'They Sign Up',body:'When someone uses your link to register, you\'re credited automatically'},
        {n:4,icon:'💰',title:'Earn Cash',body:'Earnings go straight to your wallet — withdraw anytime'}
      ]; %>
      <% steps.forEach(s => { %>
        <div style="background:var(--card);border:1px solid var(--border);border-radius:16px;padding:28px">
          <div style="width:40px;height:40px;background:var(--green);border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:16px;color:var(--black);margin:0 auto 16px"><%= s.n %></div>
          <div style="font-size:28px;margin-bottom:10px"><%= s.icon %></div>
          <h3 style="font-size:15px;font-weight:800;margin-bottom:8px"><%= s.title %></h3>
          <p style="font-size:13px;color:var(--text-dim)"><%= s.body %></p>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- Eligibility -->
  <div style="background:var(--card2);border:1px solid var(--border);border-radius:16px;padding:36px;margin-bottom:40px">
    <h3 style="font-size:22px;font-weight:900;margin-bottom:20px">📋 Eligibility Requirements</h3>
    <div class="grid-2" style="gap:16px">
      <div style="display:flex;gap:10px;font-size:14px;color:var(--text-dim)"><span style="color:var(--green)">✅</span> Must have a verified LEVEL UP account</div>
      <div style="display:flex;gap:10px;font-size:14px;color:var(--text-dim)"><span style="color:var(--green)">✅</span> Available to all seller tiers (Basic, Pro, Elite)</div>
      <div style="display:flex;gap:10px;font-size:14px;color:var(--text-dim)"><span style="color:var(--green)">✅</span> No self-referrals allowed</div>
      <div style="display:flex;gap:10px;font-size:14px;color:var(--text-dim)"><span style="color:var(--green)">✅</span> Minimum payout: 50 EGP</div>
      <div style="display:flex;gap:10px;font-size:14px;color:var(--text-dim)"><span style="color:var(--green)">✅</span> Payouts via Vodafone Cash or bank transfer</div>
      <div style="display:flex;gap:10px;font-size:14px;color:var(--text-dim)"><span style="color:var(--green)">✅</span> Cookies tracked for 30 days per click</div>
    </div>
  </div>

  <div style="text-align:center">
    <% if (user) { %>
      <a href="/seller/affiliate" class="btn btn-green btn-lg">🔗 Go to My Affiliate Dashboard</a>
    <% } else { %>
      <a href="/auth/register" class="btn btn-green btn-lg">Create Account to Start Earning</a>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
