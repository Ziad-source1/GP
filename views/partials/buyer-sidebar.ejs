<div class="sidebar">
  <div style="padding:16px 24px;border-bottom:1px solid var(--border);margin-bottom:8px">
    <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--text-muted)">Buyer Panel</div>
    <div style="font-size:14px;font-weight:700;margin-top:4px"><%= user ? user.username : 'Buyer' %></div>
  </div>

  <div class="sidebar-label">Dashboard</div>
  <div class="sidebar-section">
    <a href="/buyer/dashboard" class="sidebar-link <%= currentPath === '/buyer/dashboard' ? 'active' : '' %>">
      <span class="sidebar-link-icon">🏠</span> Overview
    </a>
    <a href="/buyer/wallet" class="sidebar-link <%= currentPath === '/buyer/wallet' ? 'active' : '' %>">
      <span class="sidebar-link-icon">💰</span> My Wallet
    </a>
  </div>

  <div class="sidebar-label">Orders</div>
  <div class="sidebar-section">
    <a href="/buyer/orders" class="sidebar-link <%= currentPath === '/buyer/active-orders' ? 'active' : '' %>">
      <span class="sidebar-link-icon">⏳</span> Orders
    </a>
    <!-- <a href="/buyer/orders-history" class="sidebar-link <%= currentPath === '/buyer/orders' ? 'active' : '' %>">
      <span class="sidebar-link-icon">📋</span> Order History
    </a> -->
    <a href="/buyer/disputes" class="sidebar-link <%= currentPath === '/buyer/disputes' ? 'active' : '' %>">
      <span class="sidebar-link-icon">⚖️</span> Disputes
    </a>
  </div>

  <div class="sidebar-label">Account</div>
  <div class="sidebar-section">
    <a href="/buyer/reviews" class="sidebar-link <%= currentPath === '/buyer/reviews' ? 'active' : '' %>">
      <span class="sidebar-link-icon">⭐</span> My Reviews
    </a>
    <a href="/buyer/notifications" class="sidebar-link <%= currentPath === '/buyer/notifications' ? 'active' : '' %>">
      <span class="sidebar-link-icon">🔔</span> Notifications
    </a>
  </div>

  <div class="sidebar-label">Quick Links</div>
  <div class="sidebar-section">
    <a href="/marketplace" class="sidebar-link">
      <span class="sidebar-link-icon">🛒</span> Browse Market
    </a>
    <% if (user.role === 'buyer') {%>
      <a href="/seller/verification" class="sidebar-link">
        <span class="sidebar-link-icon">⭐</span> Become a Seller
      </a>
    <% } %>
  </div>
</div>
